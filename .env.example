# Obtain a free key at https://developer.ticketmaster.com/
TICKETMASTER_API_KEY=replace_me
# Eventfinda issues an API username/password. Set the Auckland location ID from the account's API explorer.
EVENTFINDA_USERNAME=replace_me
EVENTFINDA_PASSWORD=replace_me
EVENTFINDA_LOCATION_ID=replace_me
AI_EXTRACTION_ENABLED=false
AI_MAX_CALLS_PER_RUN=100
